@startuml
autonumber
participant "Vue Component\n(HouseholdDetail.vue)" as UI
participant "API Client\n(HouseholdService.js)" as Client
participant "Controller\n(HouseholdController)" as Controller
participant "Service\n(GetHouseholdService)" as Service
participant "Repository\n(EloquentHouseholdRepository)" as Repo
database "SQLite DB" as DB

UI -> UI : onMounted (reads ID from route)
UI -> Client : getHousehold(id)
Client -> Controller : GET /api/households/{id}
Controller -> Service : execute(id)
Service -> Repo : findById(id)
Repo -> DB : SELECT * FROM households WHERE id=?
DB --> Repo : Raw Data Row
Repo -> Repo : Reconstitutes Domain Entity (Household)
Repo --> Service : Returns Entity
Service --> Controller : Returns Entity
Controller -> Controller : Formats via HouseholdResource
Controller -> Client : 200 OK (JSON Data)
Client --> UI : Data Binding
UI -> UI : Updates DOM
@enduml
